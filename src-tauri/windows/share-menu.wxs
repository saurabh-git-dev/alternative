<?xml version="1.0" encoding="utf-8"?>
<!-- "Share with Tools" in Explorer's right-click menu, for the MSI (the
     installer .exe does the same in share-menu.nsh). [#Path] is the app's
     .exe in Tauri's WiX template. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Fragment>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="ShareWithToolsMenu" Guid="*">
        <RegistryKey Root="HKCR" Key="*\shell\ShareWithTools">
          <RegistryValue Type="string" Value="Share with Tools" KeyPath="yes" />
          <RegistryValue Type="string" Name="Icon" Value="[#Path]" />
          <RegistryValue Type="string" Key="command" Value="&quot;[#Path]&quot; &quot;%1&quot;" />
        </RegistryKey>
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
