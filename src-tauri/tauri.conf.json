{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tools",
  "version": "0.1.0",
  "identifier": "io.github.saurabhgitdev.tools",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tools",
        "width": 1200,
        "height": 800,
        "minWidth": 360,
        "minHeight": 480,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null,
      "headers": {
        "Cross-Origin-Opener-Policy": "same-origin",
        "Cross-Origin-Embedder-Policy": "require-corp"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "PDF, image, video and IT tools that run on your device",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/share-menu.nsh"
      },
      "wix": {
        "fragmentPaths": [
          "windows/share-menu.wxs"
        ],
        "componentRefs": [
          "ShareWithToolsMenu"
        ]
      }
    },
    "linux": {
      "deb": {
        "desktopTemplate": "linux/tools.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/tools.desktop"
      }
    }
  }
}
